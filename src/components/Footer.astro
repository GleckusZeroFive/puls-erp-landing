---
import { asset } from "../utils/asset";
import { content } from "../data/content.ts";
const year = new Date().getFullYear();
const f = content.footer;

// In-page anchors only resolve on the home page; on sub-pages (privacy)
// prefix them with the home URL so the browser navigates back to the section.
const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const isHome = currentPath === base;
const anchorBase = isHome ? "" : asset("/");
---

<footer class="bg-[var(--color-primary)] text-white/70">
  <div class="mx-auto max-w-[1600px] px-6 py-14">
    <div class="grid md:grid-cols-[1.5fr_1fr_1fr_1fr] gap-10 mb-12">
      <div>
        <div class="inline-flex flex-col items-center gap-0.5 leading-none mb-4">
          <img src={asset("/logo-pulse.png")} alt="" class="h-9 w-auto" aria-hidden="true" />
          <span class="font-bold uppercase tracking-[0.3em] text-white text-sm pl-[0.3em] translate-x-[3px]">Puls</span>
        </div>
        <p class="text-sm leading-relaxed text-white/60 max-w-xs">
          {f.tagline}
        </p>
      </div>

      <div>
        <div class="text-xs uppercase tracking-widest text-white/40 mb-4 font-medium">Продукт</div>
        <ul class="space-y-2.5 text-sm">
          <li><a href={`${anchorBase}#what`} class="hover:text-white transition">Что такое Puls</a></li>
          <li><a href={`${anchorBase}#dashboard`} class="hover:text-white transition">Дашборд</a></li>
          <li><a href={`${anchorBase}#roles`} class="hover:text-white transition">Роли на стройке</a></li>
          <li><a href={`${anchorBase}#scenarios`} class="hover:text-white transition">Сценарии</a></li>
        </ul>
      </div>

      <div>
        <div class="text-xs uppercase tracking-widest text-white/40 mb-4 font-medium">Компания</div>
        <ul class="space-y-2.5 text-sm">
          <li><a href={`${anchorBase}#trust`} class="hover:text-white transition">Опыт</a></li>
          <li><a href={`${anchorBase}#pilot`} class="hover:text-white transition">Условия пилота</a></li>
          <li><a href={`${anchorBase}#faq`} class="hover:text-white transition">Вопросы и ответы</a></li>
          <li><a href={asset("/privacy")} class="hover:text-white transition">Обработка данных</a></li>
        </ul>
      </div>

      <div>
        <div class="text-xs uppercase tracking-widest text-white/40 mb-4 font-medium">Связаться</div>
        <ul class="space-y-2.5 text-sm">
          <li><a href={`${anchorBase}#form`} class="hover:text-white transition">Заявка</a></li>
          <li><a href="mailto:hello@puls-erp.ru" class="hover:text-white transition">hello@puls-erp.ru</a></li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-white/10 text-xs text-white/40 space-y-4">
      <p class="leading-relaxed max-w-3xl">
        {f.legal}
      </p>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>© {year} {f.copyright}</div>
        <div>{f.madeIn}</div>
      </div>
    </div>
  </div>
</footer>
