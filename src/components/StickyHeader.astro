---
import { asset } from "../utils/asset";
---

<header id="sticky-header" class="sticky-header fixed top-0 inset-x-0 z-50">
  <div class="mx-auto max-w-[1400px] px-6 h-16 flex items-center justify-between">
    <a href="#hero" class="flex items-center gap-2.5 leading-none">
      <img src={asset("/logo-pulse.png")} alt="" class="h-7 w-auto" aria-hidden="true" />
      <span class="font-bold uppercase tracking-[0.2em] text-sm text-white">Puls</span>
    </a>
    <nav class="hidden lg:flex items-center gap-7 text-sm text-white/70">
      <a href="#what" class="hover:text-white transition">Что такое Puls</a>
      <a href="#dashboard" class="hover:text-white transition">Дашборд</a>
      <a href="#roles" class="hover:text-white transition">Роли</a>
      <a href="#pilot" class="hover:text-white transition">Условия пилота</a>
    </nav>
    <a href="#form" class="inline-flex items-center gap-2 bg-[var(--color-accent)] hover:opacity-90 transition px-5 py-2.5 rounded-xl font-medium text-sm text-white">
      Подать заявку
    </a>
  </div>
</header>

<script is:inline>
  // Показывает шапку, когда #hero ушёл из вида, и прячет на секции #form.
  (() => {
    function init() {
      const header = document.getElementById("sticky-header");
      const hero = document.getElementById("hero");
      const form = document.getElementById("form");
      if (!header || !hero || !("IntersectionObserver" in window)) return;
      let pastHero = false;
      let atForm = false;
      const update = () => header.classList.toggle("is-shown", pastHero && !atForm);
      new IntersectionObserver(([e]) => { pastHero = !e.isIntersecting; update(); }, { threshold: 0 }).observe(hero);
      if (form) {
        new IntersectionObserver(([e]) => { atForm = e.isIntersecting; update(); }, { threshold: 0.12 }).observe(form);
      }
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>
