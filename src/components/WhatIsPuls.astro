---
import Icon from "./Icon.astro";
import { content } from "../data/content.ts";

const { eyebrow, h2, p1, p2, pillars } = content.what;
---

<section id="what" class="bg-white">
  <div class="mx-auto max-w-[1400px] px-6 py-20 md:py-24">
    <div class="grid lg:grid-cols-[1fr_1.1fr] gap-12 items-start">
      <div class="reveal">
        <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-3 font-medium">{eyebrow}</div>
        <h2 class="font-bold text-3xl md:text-4xl mb-5 leading-tight">
          {h2}
        </h2>
        <p class="text-[var(--color-gray-1)] text-lg leading-relaxed mb-5">
          {p1}
        </p>
        <p class="text-[var(--color-gray-1)] leading-relaxed">
          {p2}
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-4 reveal-group">
        {pillars.map((p) => (
          <div class="bg-[var(--color-gray-3)] rounded-2xl p-6 border border-[var(--color-gray-2)] card-hover">
            <span class="inline-flex w-11 h-11 rounded-xl bg-[var(--color-primary)]/5 text-[var(--color-primary)] items-center justify-center mb-4">
              <Icon name={p.icon} size={22} />
            </span>
            <div class="font-bold text-lg mb-2 text-[var(--color-primary)]">{p.title}</div>
            <div class="text-[var(--color-gray-1)] text-sm leading-relaxed">{p.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
