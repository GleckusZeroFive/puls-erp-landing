---
import Icon from "./Icon.astro";
import { content } from "../data/content.ts";

const { eyebrow, h2, lead, zonesTitle, zones, note, disclaimer, extrasTitle, extras } = content.what;
---

<section id="what" class="bg-white">
  <div class="mx-auto max-w-[1400px] px-6 py-20 md:py-24">
    <div class="reveal max-w-3xl mx-auto text-center mb-12">
      <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-3 font-medium">{eyebrow}</div>
      <h2 class="font-bold text-3xl md:text-4xl mb-5 leading-tight">{h2}</h2>
      <p class="text-[var(--color-gray-1)] text-lg leading-relaxed">{lead}</p>
    </div>

    <!-- Четыре зоны — интерактивный мини-пульт -->
    <div class="reveal" data-switch="zones">
      <div class="text-sm font-semibold text-[var(--color-primary)] mb-4">{zonesTitle}</div>

      <div class="grid lg:grid-cols-[minmax(0,340px)_1fr] gap-5">
        <!-- Вкладки зон -->
        <div class="flex lg:flex-col gap-2 overflow-x-auto no-scrollbar scroll-x-fade -mx-1 px-1" role="tablist" aria-label={zonesTitle}>
          {zones.map((z, i) => (
            <button
              type="button"
              data-tab={z.id}
              class={`zone-tab ${i === 0 ? "is-active" : ""}`}
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
            >
              <span class="zone-ic"><Icon name={z.icon} size={20} /></span>
              <span class="zone-title">{z.title}</span>
            </button>
          ))}
        </div>

        <!-- Панель активной зоны -->
        <div class="switch-stack">
          {zones.map((z, i) => (
            <div data-pane={z.id} class={i === 0 ? "is-active" : ""}>
              <div class="zone-pane">
                <div class="font-bold text-lg text-[var(--color-primary)] mb-2">{z.title}</div>
                <p class="text-[var(--color-gray-1)] leading-relaxed mb-5">{z.desc}</p>
                <ul class="space-y-2.5">
                  {z.signals.map((s) => (
                    <li class={`sig sig-${s.tone}`}>
                      <span class="text-sm text-[var(--color-primary)]">{s.text}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>

      <p class="text-xs text-[var(--color-gray-1)] mt-4">{note}</p>
      <p class="text-xs text-[var(--color-gray-1)]/70 italic mt-1">{disclaimer}</p>
    </div>

    <!-- Дополнительные возможности -->
    <div class="mt-14 reveal">
      <div class="text-sm font-semibold text-[var(--color-primary)] mb-4">{extrasTitle}</div>
      <div class="grid sm:grid-cols-3 gap-4 reveal-group">
        {extras.map((p) => (
          <div class="bg-[var(--color-gray-3)] rounded-2xl p-6 border border-[var(--color-gray-2)] card-hover">
            <span class="inline-flex w-11 h-11 rounded-xl bg-[var(--color-accent)]/10 text-[var(--color-accent)] items-center justify-center mb-4">
              <Icon name={p.icon} size={22} />
            </span>
            <div class="font-bold mb-2 text-[var(--color-primary)] leading-snug">{p.title}</div>
            <div class="text-[var(--color-gray-1)] text-sm leading-relaxed">{p.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .zone-tab {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 0 0 auto;
    text-align: left;
    padding: 0.85rem 1rem;
    border-radius: 1rem;
    border: 1px solid var(--color-gray-2);
    background: #fff;
    cursor: pointer;
    transition: border-color 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease;
  }
  @media (min-width: 1024px) {
    .zone-tab { width: 100%; }
  }
  .zone-tab:hover {
    border-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
  }
  .zone-tab.is-active {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 6%, #fff);
    box-shadow: 0 6px 20px -12px color-mix(in srgb, var(--color-accent) 60%, transparent);
  }
  .zone-ic {
    display: inline-flex;
    width: 2.25rem;
    height: 2.25rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-accent);
  }
  .zone-title {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-primary);
    white-space: nowrap;
  }
  /* Статус-строки в духе продукта: белая карточка-строка + цветная риска-акцент слева. */
  .sig {
    display: flex;
    align-items: center;
    padding: 0.6rem 0.9rem;
    background: #fff;
    border: 1px solid var(--color-gray-2);
    border-left: 3px solid var(--sig);
    border-radius: 0.7rem;
  }
  .sig-ok { --sig: #2BA84A; }
  .sig-warn { --sig: #F0A500; }
  .sig-risk { --sig: var(--color-danger); }

  .zone-pane {
    border: 1px solid var(--color-gray-2);
    border-radius: 1.25rem;
    background: var(--color-gray-3);
    padding: 1.5rem 1.5rem 1.6rem;
    height: 100%;
  }

</style>
