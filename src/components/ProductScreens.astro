---
// Вьюер экранов продукта: вкладки переключают скрины объекта.
// Движок: switch-stack (data-switch/data-tab/data-pane) + JS в Layout.astro.
// Окно прокручивается внутри рамки (overscroll-contain); тень+хинт снизу — аффорданс прокрутки.
import TabSwitch from "./TabSwitch.astro";
import { asset } from "../utils/asset";
import { content } from "../data/content.ts";

const { chromeTitle, note, screens } = content.dashboard;
const tabs = screens.map((s) => ({ id: s.id, label: s.label }));
---

<div data-switch="objscreen">
  <div class="reveal mb-6 text-center">
    <TabSwitch tabs={tabs} variant="bar" label="Раздел карточки объекта" />
  </div>

  <!-- Окно продукта -->
  <div class="reveal rounded-2xl overflow-hidden border border-[var(--color-gray-2)] shadow-2xl bg-white">
    <!-- chrome -->
    <div class="flex items-center gap-2 px-4 py-3 border-b border-[var(--color-gray-2)] bg-[var(--color-gray-3)]">
      <span class="w-3 h-3 rounded-full bg-[#FF5F57]"></span>
      <span class="w-3 h-3 rounded-full bg-[#FEBC2E]"></span>
      <span class="w-3 h-3 rounded-full bg-[#28C840]"></span>
      <span class="ml-3 text-xs text-[var(--color-gray-1)] truncate">{chromeTitle}</span>
      <button
        type="button"
        class="screens-toggle ml-auto inline-flex items-center gap-1.5 text-xs font-medium text-[var(--color-primary)] bg-white border border-[var(--color-gray-2)] hover:bg-[var(--color-gray-3)] transition rounded-lg px-2.5 py-1.5 shrink-0"
        aria-pressed="false"
      >
        <svg class="toggle-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
        <span class="toggle-label hidden sm:inline">Показать целиком</span>
      </button>
    </div>
    <!-- экраны наложены (switch-stack): окно одной высоты, без скачков при переключении -->
    <div class="switch-stack">
      {screens.map((s, i) => (
        <div class={i === 0 ? "is-active" : ""} data-pane={s.id}>
          <div class="screen-window relative bg-[#E0E4ED]">
            <div class="screen-scroll h-[420px] md:h-[520px] overflow-auto overscroll-contain">
              <img
                src={asset(s.img)}
                alt={s.alt}
                loading="lazy"
                class="w-full h-auto block"
              />
            </div>
            <!-- аффорданс прокрутки: тень-фейд + хинт; прячутся у нижнего края -->
            <div class="screen-fade pointer-events-none absolute inset-x-0 bottom-0 h-14 bg-gradient-to-t from-black/15 to-transparent"></div>
            <div class="screen-hint pointer-events-none absolute bottom-3 right-3 flex items-center gap-1 text-[11px] text-white bg-black/55 backdrop-blur-sm px-2.5 py-1 rounded-full">
              листайте экран
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <p class="reveal mt-4 text-sm text-[var(--color-gray-1)]">
    {note}
  </p>
</div>

<style>
  /* анимация высоты окна (interpolate-size; без поддержки — мгновенно) */
  [data-switch="objscreen"] {
    interpolate-size: allow-keywords;
  }
  .screen-scroll {
    transition: height 380ms cubic-bezier(0.4, 0, 0.2, 1);
    /* scrollbar-gutter: резерв под скроллбар, ширина контента не скачет */
    scrollbar-gutter: stable;
  }
  /* развёрнутый режим: высота auto, overflow остаётся auto */
  [data-switch="objscreen"].is-expanded .screen-scroll {
    height: auto;
  }
  /* развёрнутый режим: неактивные панели скрыты */
  [data-switch="objscreen"].is-expanded .switch-stack > [data-pane]:not(.is-active) {
    display: none;
  }
  [data-switch="objscreen"].is-expanded .screen-fade,
  [data-switch="objscreen"].is-expanded .screen-hint {
    display: none;
  }
  /* аффорданс прокрутки гаснет, когда долистали до низа окна */
  .screen-window[data-at-end] .screen-fade,
  .screen-window[data-at-end] .screen-hint {
    opacity: 0;
  }
  .screen-fade,
  .screen-hint {
    transition: opacity 240ms ease;
  }
  /* аккуратный тонкий скроллбар внутри окна */
  .screen-scroll {
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 0, 0, 0.25) transparent;
  }
  .screen-scroll::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  .screen-scroll::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.22);
    border-radius: 8px;
  }
</style>

<script>
  // Прячем тень/хинт, когда окно долистано до низа (или контент не прокручивается).
  function initScreenScroll() {
    document.querySelectorAll<HTMLElement>(".screen-scroll").forEach((el) => {
      const win = el.closest<HTMLElement>(".screen-window");
      if (!win) return;
      const update = () => {
        const atEnd = el.scrollHeight - el.scrollTop - el.clientHeight < 8;
        if (atEnd) win.setAttribute("data-at-end", "");
        else win.removeAttribute("data-at-end");
      };
      el.addEventListener("scroll", update, { passive: true });
      // первичная проверка (контент короче окна → сразу прячем хинт)
      requestAnimationFrame(update);
    });
  }
  initScreenScroll();

  // Тоггл «показать экран целиком ⇄ свернуть в окно с прокруткой»
  function initExpandToggle() {
    document.querySelectorAll<HTMLElement>('[data-switch="objscreen"]').forEach((root) => {
      const btn = root.querySelector<HTMLButtonElement>(".screens-toggle");
      const label = btn?.querySelector<HTMLElement>(".toggle-label");
      if (!btn) return;
      btn.addEventListener("click", () => {
        const expanded = root.classList.toggle("is-expanded");
        btn.setAttribute("aria-pressed", expanded ? "true" : "false");
        if (label) label.textContent = expanded ? "Свернуть в окно" : "Показать целиком";
        // при сворачивании вернуть активное окно к началу
        if (!expanded) {
          root.querySelectorAll<HTMLElement>(".screen-scroll").forEach((el) => { el.scrollTop = 0; });
        }
      });
    });
  }
  initExpandToggle();

  document.addEventListener("astro:after-swap", () => { initScreenScroll(); initExpandToggle(); });
</script>
