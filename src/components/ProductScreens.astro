---
// Вьюер экранов продукта: вкладки переключают скрины объекта.
// Движок: switch-stack (data-switch/data-tab/data-pane) + JS в Layout.astro.
// Окно показывает кадр экрана; клик по экрану открывает его целиком в lightbox.
import TabSwitch from "./TabSwitch.astro";
import { asset } from "../utils/asset";
import { content } from "../data/content.ts";

const { chromeTitle, note, screens } = content.dashboard;
const tabs = screens.map((s) => ({ id: s.id, label: s.label }));
---

<div data-switch="objscreen">
  <div class="reveal mb-6 text-center">
    <TabSwitch tabs={tabs} variant="bar" label="Раздел карточки объекта" />
  </div>

  <!-- Подпись-дисклеймер НАД окном: читают до того, как формируют ожидания об интерфейсе -->
  <p class="reveal mb-5 text-sm text-[var(--color-gray-1)] text-center max-w-3xl mx-auto">
    {note}
  </p>

  <!-- Окно продукта -->
  <div class="reveal rounded-2xl overflow-hidden border border-[var(--color-gray-2)] shadow-2xl bg-white">
    <!-- chrome -->
    <div class="flex items-center gap-2 px-4 py-3 border-b border-[var(--color-gray-2)] bg-[var(--color-gray-3)]">
      <span class="w-3 h-3 rounded-full bg-[#FF5F57]"></span>
      <span class="w-3 h-3 rounded-full bg-[#FEBC2E]"></span>
      <span class="w-3 h-3 rounded-full bg-[#28C840]"></span>
      <span class="ml-3 text-xs text-[var(--color-gray-1)] truncate">{chromeTitle}</span>
    </div>
    <!-- экраны наложены (switch-stack): окно одной высоты, без скачков при переключении -->
    <div class="switch-stack">
      {screens.map((s, i) => (
        <div class={i === 0 ? "is-active" : ""} data-pane={s.id}>
          <div class="screen-window relative bg-[#E0E4ED]">
            <div class="screen-scroll h-[160px] md:h-[520px] overflow-hidden">
              <img
                src={asset(s.img)}
                alt={s.alt}
                loading="lazy"
                data-zoomable
                class="w-full h-auto block cursor-zoom-in"
              />
            </div>
            <span class="zoom-hint">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3M11 8v6M8 11h6"/></svg>
              крупнее
            </span>
            <!-- крой-индикатор: тень снизу = экран продолжается ниже, клик открывает целиком -->
            <div class="screen-fade pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-black/25 to-transparent"></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .screen-fade { transition: opacity 240ms ease; }
</style>
