---
import { content } from "../data/content.ts";

const { eyebrow, h2, lead, items: faq } = content.faq;
---

<section id="faq" class="bg-white">
  <div class="mx-auto max-w-3xl px-6 py-20 md:py-24">
    <div class="reveal mb-10 text-center">
      <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-3 font-medium">{eyebrow}</div>
      <h2 class="font-bold text-3xl md:text-4xl mb-5 leading-tight">
        {h2}
      </h2>
      <p class="text-[var(--color-gray-1)] text-lg leading-relaxed">
        {lead}
      </p>
    </div>

    <div class="space-y-3 reveal">
      {faq.map((item) => (
        <details class="faq-item group bg-[var(--color-gray-3)] rounded-2xl border border-[var(--color-gray-2)] overflow-hidden">
          <summary class="flex items-center justify-between gap-4 cursor-pointer px-6 py-5">
            <span class="font-semibold text-[var(--color-primary)] text-[17px] leading-snug">{item.q}</span>
            <span class="chevron shrink-0 text-[var(--color-accent)]">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </span>
          </summary>
          <div class="details-body">
            <div class="details-inner">
              <p class="px-6 pb-6 text-[var(--color-gray-1)] leading-relaxed">{item.a}</p>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
