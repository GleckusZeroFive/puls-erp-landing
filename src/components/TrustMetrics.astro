---
import { content } from "../data/content.ts";

const { eyebrow, h2, lead, metrics } = content.trust;
---

<section id="trust" class="bg-[var(--color-gray-3)]">
  <div class="mx-auto max-w-[1600px] px-6 py-20 md:py-24">
    <div class="reveal max-w-3xl mx-auto text-center mb-12">
      <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-3 font-medium">{eyebrow}</div>
      <h2 class="font-bold text-3xl md:text-4xl mb-5 leading-tight">
        {h2}
      </h2>
      <p class="text-[var(--color-gray-1)] text-lg leading-relaxed">
        {lead}
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 reveal-group">
      {metrics.map((m) => (
        <div class="bg-white rounded-2xl p-6 border border-[var(--color-gray-2)] card-hover">
          <div class="font-black text-3xl text-[var(--color-primary)] leading-none mb-2" data-countup>{m.value}</div>
          <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] font-semibold mb-3">{m.label}</div>
          <div class="text-[var(--color-gray-1)] text-sm leading-relaxed">{m.desc}</div>
        </div>
      ))}
    </div>
  </div>
</section>
