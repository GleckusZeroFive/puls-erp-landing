---
const metrics = [
  { value: "19 лет", label: "опыта в стройке", desc: "Путь от рабочего-кровельщика до собственника подрядного бизнеса." },
  { value: "до 22", label: "объектов параллельно", desc: "Пиковая загрузка 2025 года, без потери управляемости." },
  { value: "~600 млн ₽", label: "годовой оборот", desc: "Понимаем цену простоя, кассового разрыва и сорванной КС-2." },
  { value: "из практики", label: "а не из теории", desc: "Прошли через споры с заказчиками, срывы поставок и потерянные допработы." },
];
---

<section id="trust" class="bg-[var(--color-gray-3)]">
  <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
    <div class="reveal max-w-3xl mb-12">
      <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-3 font-medium">Опыт из реальной жизни</div>
      <h2 class="font-bold text-3xl md:text-4xl mb-5 leading-tight">
        Не теория про IT. Опыт из сурового строительного подряда
      </h2>
      <p class="text-[var(--color-gray-1)] text-lg leading-relaxed">
        За системой стоит подрядная компания, которая сама прошла путь от рабочего до оборота
        в сотни миллионов — и сделала продукт под собственный строительный хаос.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 reveal">
      {metrics.map((m) => (
        <div class="bg-white rounded-2xl p-6 border border-[var(--color-gray-2)]">
          <div class="font-black text-3xl text-[var(--color-primary)] leading-none mb-2">{m.value}</div>
          <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] font-semibold mb-3">{m.label}</div>
          <div class="text-[var(--color-gray-1)] text-sm leading-relaxed">{m.desc}</div>
        </div>
      ))}
    </div>
  </div>
</section>
