---
import { scenarios } from "../data/scenarios.ts";
---

<div
  role="tablist"
  aria-label="Сценарий дашборда"
  class="pulse-tabs inline-flex flex-wrap items-center gap-1 bg-[var(--color-gray-3)] rounded-2xl p-1.5 border border-[var(--color-gray-2)]"
>
  {scenarios.map((s, i) => (
    <button
      type="button"
      role="tab"
      data-pulse-tab={s.id}
      aria-selected={i === 0 ? "true" : "false"}
      class={`pulse-tab cursor-pointer px-4 py-2.5 rounded-xl text-sm font-medium transition ${i === 0 ? 'is-active' : ''}`}
    >
      {s.label}
    </button>
  ))}
</div>

<style is:global>
  .pulse-tab {
    color: var(--color-gray-1);
    background-color: transparent;
  }
  .pulse-tab:hover {
    color: var(--color-primary);
  }
  .pulse-tab.is-active {
    background-color: var(--color-primary);
    color: #fff;
  }
</style>
