---
import Icon from "./Icon.astro";
import TabSwitch from "./TabSwitch.astro";
import { asset } from "../utils/asset";
import { roles } from "../data/roles.ts";

const tabs = roles.map((r) => ({ id: r.id, label: r.tab }));
---

<section id="roles" class="bg-[var(--color-gray-3)]">
  <div class="mx-auto max-w-[1400px] px-6 py-20 md:py-24" data-switch="roles">
    <div class="reveal max-w-3xl mb-8">
      <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-3 font-medium">Роли на стройке</div>
      <h2 class="font-bold text-3xl md:text-4xl mb-5 leading-tight">
        У каждой роли — свой экран с оперативной информацией
      </h2>
      <p class="text-[var(--color-gray-1)] text-lg leading-relaxed">
        Puls — инструмент для всей команды, а не только надзор сверху. У каждого свой простой
        экран со своими задачами: сотрудникам — проще и быстрее работать, директору — связанная
        картина по компании и уверенность, что исполнение идёт качественно.
      </p>
    </div>

    <div class="reveal mb-8">
      <TabSwitch tabs={tabs} variant="pill" label="Роль в компании" />
    </div>

    <div class="switch-stack reveal">
      {roles.map((r, i) => (
        <div class={i === 0 ? "is-active" : ""} data-pane={r.id}>
          <div class="grid lg:grid-cols-[1fr_1.25fr] gap-5 items-start">
            <!-- Текст роли -->
            <div class="bg-white rounded-2xl p-7 border border-[var(--color-gray-2)]">
              {r.badge && (
                <div class="inline-flex items-center gap-2 text-[11px] uppercase tracking-widest font-semibold text-[var(--color-accent)] bg-[var(--color-accent)]/10 px-2.5 py-1 rounded-full mb-4">
                  {r.badge}
                </div>
              )}
              <div class="flex items-center gap-3 mb-3">
                <span class="inline-flex w-10 h-10 rounded-xl bg-[var(--color-primary)]/8 text-[var(--color-primary)] items-center justify-center shrink-0">
                  <Icon name={r.icon} size={20} />
                </span>
                <h3 class="font-bold text-xl md:text-2xl text-[var(--color-primary)] leading-snug">{r.title}</h3>
              </div>
              <p class="text-[var(--color-gray-1)] leading-relaxed mb-5">{r.desc}</p>
              <div class="space-y-3 pt-4 border-t border-[var(--color-gray-2)]">
                <div>
                  <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-1 font-medium">Что видит</div>
                  <div class="text-[var(--color-primary)] text-[15px] leading-relaxed">{r.sees}</div>
                </div>
                <div>
                  <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-1 font-medium">Личная выгода</div>
                  <div class="text-[var(--color-primary)] text-[15px] leading-relaxed">{r.benefit}</div>
                </div>
              </div>
            </div>

            <!-- Реальный экран продукта (Figma Юры) -->
            <div class="rounded-2xl overflow-hidden border border-[var(--color-gray-2)] shadow-xl bg-white">
              <div class="flex items-center gap-2 px-4 py-2.5 border-b border-[var(--color-gray-2)] bg-[var(--color-gray-3)]">
                <span class="w-2.5 h-2.5 rounded-full bg-[#FF5F57]"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#FEBC2E]"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#28C840]"></span>
                <span class="ml-2 text-[11px] text-[var(--color-gray-1)] truncate">Puls · {r.tab}</span>
              </div>
              <div class="aspect-[16/10] overflow-hidden bg-[#E0E4ED]">
                <img src={asset(r.img)} alt={r.imgAlt} loading="lazy" class="w-full h-full object-cover object-top block" />
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
