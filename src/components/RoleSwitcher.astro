---
import Icon from "./Icon.astro";
import TabSwitch from "./TabSwitch.astro";
import { asset } from "../utils/asset";
import { content } from "../data/content.ts";

const { eyebrow, h2, intro, items: roles } = content.roles;
const tabs = roles.map((r) => ({ id: r.id, label: r.tab }));
---

<section id="roles" class="bg-[var(--color-gray-3)]">
  <div class="mx-auto max-w-[1600px] px-6 py-20 md:py-24" data-switch="roles">
    <div class="reveal max-w-3xl mx-auto text-center mb-8">
      <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-3 font-medium">{eyebrow}</div>
      <h2 class="font-bold text-3xl md:text-4xl mb-5 leading-tight">
        {h2}
      </h2>
      <p class="text-[var(--color-gray-1)] text-lg leading-relaxed">
        {intro}
      </p>
    </div>

    <div class="reveal mb-8">
      <TabSwitch tabs={tabs} variant="bar" label="Роль в компании" />
    </div>

    <div class="switch-stack reveal">
      {roles.map((r, i) => (
        <div class={i === 0 ? "is-active" : ""} data-pane={r.id}>
          <!-- Описание роли СВЕРХУ (в две колонки), чтобы экран ниже шёл во всю ширину -->
          <div class="bg-white rounded-2xl p-6 md:p-8 border border-[var(--color-gray-2)] mb-5">
            <div class="grid md:grid-cols-[1fr_1.3fr] gap-x-10 gap-y-5 items-start">
              <div>
                {r.badge && (
                  <div class="inline-flex items-center gap-2 text-[11px] uppercase tracking-widest font-semibold text-[var(--color-accent)] bg-[var(--color-accent)]/10 px-2.5 py-1 rounded-full mb-4">
                    {r.badge}
                  </div>
                )}
                <div class="flex items-center gap-3 mb-3">
                  <span class="inline-flex w-10 h-10 rounded-xl bg-[var(--color-primary)]/8 text-[var(--color-primary)] items-center justify-center shrink-0">
                    <Icon name={r.icon} size={20} />
                  </span>
                  <h3 class="font-bold text-xl md:text-2xl text-[var(--color-primary)] leading-snug">{r.title}</h3>
                </div>
                <p class="text-[var(--color-gray-1)] leading-relaxed mb-4">{r.desc}</p>
                <div>
                  <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-1 font-medium">Личная выгода</div>
                  <div class="text-[var(--color-primary)] text-[15px] leading-relaxed">{r.benefit}</div>
                </div>
              </div>
              <div class="md:border-l md:border-[var(--color-gray-2)] md:pl-10">
                <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-3 font-medium">Что видит</div>
                <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-2">
                  {r.sees.map((s) => (
                    <li class="flex gap-2 text-[var(--color-primary)] text-sm leading-snug">
                      <Icon name="check" size={15} class="mt-0.5 shrink-0 text-[var(--color-accent)]" />
                      <span>{s}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <!-- Экран роли во ВСЮ ширину (как окно продукта) -->
          <div class="rounded-2xl overflow-hidden border border-[var(--color-gray-2)] shadow-2xl bg-white">
            <div class="flex items-center gap-2 px-4 py-3 border-b border-[var(--color-gray-2)] bg-[var(--color-gray-3)]">
              <span class="w-3 h-3 rounded-full bg-[#FF5F57]"></span>
              <span class="w-3 h-3 rounded-full bg-[#FEBC2E]"></span>
              <span class="w-3 h-3 rounded-full bg-[#28C840]"></span>
              <span class="ml-3 text-xs text-[var(--color-gray-1)] truncate">Puls · {r.tab}</span>
            </div>
            <div class="screen-window relative bg-[#E0E4ED]">
              <div class="screen-scroll h-auto md:h-[520px] overflow-visible md:overflow-hidden">
                <img src={asset(r.img)} alt={r.imgAlt} loading="lazy" data-zoomable class="w-full h-auto block cursor-zoom-in" />
              </div>
              <span class="zoom-hint">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3M11 8v6M8 11h6"/></svg>
                крупнее
              </span>
              <div class="screen-fade pointer-events-none absolute inset-x-0 bottom-0 h-14 bg-gradient-to-t from-black/15 to-transparent hidden md:block"></div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
