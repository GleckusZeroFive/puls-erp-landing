---
/**
 * Декоративный паттерн «силуэт города» в стиле Юры:
 * тонкие штрихи высоток на navy-фоне (фасады + вертикальные линии-окна).
 * Используется в Hero и AI-banner-е PulseDashboard как фоновая иллюстрация.
 * Сам по себе прозрачный — родитель должен быть navy.
 */
interface Props {
  className?: string;
  /** Прозрачность штрихов, по умолчанию 0.14 */
  opacity?: number;
}
const { className = "", opacity = 0.14 } = Astro.props;
---

<svg
  class={`city-pattern ${className}`}
  viewBox="0 0 600 360"
  preserveAspectRatio="xMaxYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <g fill="none" stroke="#FFFFFF" stroke-opacity={opacity} stroke-width="1" stroke-linecap="square">
    <!-- Building 1 — самый высокий, центр-лево -->
    <path d="M120 360 L120 70 L180 50 L180 360 Z" />
    <path d="M132 360 L132 80" />
    <path d="M144 360 L144 75" />
    <path d="M156 360 L156 70" />
    <path d="M168 360 L168 65" />
    <line x1="150" y1="50" x2="150" y2="20" />
    <line x1="120" y1="120" x2="180" y2="120" />
    <line x1="120" y1="180" x2="180" y2="180" />
    <line x1="120" y1="240" x2="180" y2="240" />
    <line x1="120" y1="300" x2="180" y2="300" />

    <!-- Building 2 — средний, правее -->
    <path d="M210 360 L210 140 L290 130 L290 360 Z" />
    <path d="M225 360 L225 140" />
    <path d="M240 360 L240 138" />
    <path d="M255 360 L255 136" />
    <path d="M270 360 L270 134" />
    <line x1="210" y1="200" x2="290" y2="200" />
    <line x1="210" y1="260" x2="290" y2="260" />
    <line x1="210" y1="320" x2="290" y2="320" />

    <!-- Building 3 — низкий, дальше справа -->
    <path d="M325 360 L325 200 L390 195 L390 360 Z" />
    <path d="M340 360 L340 200" />
    <path d="M355 360 L355 199" />
    <path d="M372 360 L372 198" />
    <line x1="325" y1="250" x2="390" y2="250" />
    <line x1="325" y1="305" x2="390" y2="305" />

    <!-- Building 4 — самый высокий справа, обрезается по краю -->
    <path d="M420 360 L420 30 L520 20 L520 360" />
    <path d="M438 360 L438 35" />
    <path d="M456 360 L456 32" />
    <path d="M476 360 L476 28" />
    <path d="M498 360 L498 24" />
    <line x1="470" y1="20" x2="470" y2="0" />
    <line x1="420" y1="90" x2="520" y2="90" />
    <line x1="420" y1="150" x2="520" y2="150" />
    <line x1="420" y1="210" x2="520" y2="210" />
    <line x1="420" y1="270" x2="520" y2="270" />
    <line x1="420" y1="330" x2="520" y2="330" />
  </g>
</svg>

<style>
  .city-pattern {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
