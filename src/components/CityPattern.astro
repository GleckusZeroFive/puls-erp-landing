---
/**
 * Декоративная фоновая текстура (стеклянный фасад) поверх navy primary.
 * Прозрачная сама по себе — родитель должен быть navy + position: relative + overflow: hidden.
 */
import { asset } from "../utils/asset";

interface Props {
  className?: string;
  /** Прозрачность текстуры, по умолчанию 0.2 */
  opacity?: number;
}
const { className = "", opacity = 0.2 } = Astro.props;
const bgUrl = asset("/figma/glass-facade.webp");
---

<div
  class={`city-pattern ${className}`}
  style={`opacity: ${opacity}; background-image: url(${bgUrl});`}
  aria-hidden="true"
></div>

<style>
  .city-pattern {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    pointer-events: none;
    filter: blur(2px) saturate(0.85);
    /* scale компенсирует расплыв краёв от blur */
    transform: scale(1.04);
    transform-origin: center;
  }
</style>
