---
import Icon from "./Icon.astro";
import { content } from "../data/content.ts";

const { eyebrow, h2, lead, blindLabel, items: tools, puls } = content.tools;
---

<section id="tools" class="bg-[var(--color-gray-3)]">
  <div class="mx-auto max-w-[1600px] px-6 py-20 md:py-24">
    <div class="reveal max-w-3xl mx-auto text-center mb-12">
      <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-3 font-medium">{eyebrow}</div>
      <h2 class="font-bold text-3xl md:text-4xl mb-5 leading-tight">
        {h2}
      </h2>
      <p class="text-[var(--color-gray-1)] text-lg leading-relaxed">
        {lead}
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4 reveal-group">
      {tools.map((t) => (
        <div class="bg-white rounded-2xl p-6 border border-[var(--color-gray-2)] flex flex-col card-hover">
          <span class="inline-flex w-11 h-11 rounded-xl bg-[var(--color-gray-3)] text-[var(--color-primary)] items-center justify-center mb-4">
            <Icon name={t.icon} size={22} />
          </span>
          <div class="font-bold text-lg text-[var(--color-primary)] mb-2">{t.name}</div>
          <div class="text-[var(--color-gray-1)] text-sm leading-relaxed mb-4">{t.body}</div>
          <div class="mt-auto pt-4 border-t border-[var(--color-gray-2)]">
            <div class="text-[11px] uppercase tracking-widest text-[var(--color-danger)] font-semibold mb-1.5">{blindLabel}</div>
            <div class="text-[var(--color-gray-1)] text-sm leading-snug">{t.problem}</div>
          </div>
        </div>
      ))}

      <div class="bg-[var(--color-primary)] text-white rounded-2xl p-6 flex flex-col border-2 border-[var(--color-accent-light)] card-hover">
        <span class="inline-flex w-11 h-11 rounded-xl bg-[var(--color-accent)] text-white items-center justify-center mb-4">
          <Icon name="sparkles" size={22} />
        </span>
        <div class="font-bold text-lg mb-2">{puls.name}</div>
        <div class="text-white/80 text-sm leading-relaxed mb-4">
          {puls.body}
        </div>
        <div class="mt-auto pt-4 border-t border-white/15">
          <div class="text-[11px] uppercase tracking-widest text-[var(--color-accent-light)] font-semibold mb-1.5">{puls.resultLabel}</div>
          <div class="text-white/90 text-sm leading-snug">
            {puls.result}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
