---
import Icon from "./Icon.astro";
import { content } from "../data/content.ts";

const { badge, h2, lead, cards, cta } = content.pilot;
---

<section id="pilot" class="bg-[var(--color-gray-3)]">
  <div class="mx-auto max-w-[1400px] px-6 py-20 md:py-24">
    <div class="reveal rounded-3xl border-2 border-dashed border-[var(--color-primary)]/25 bg-white p-8 md:p-12">
      <div class="inline-flex items-center gap-2 text-[11px] uppercase tracking-widest font-semibold text-[var(--color-accent)] bg-[var(--color-accent)]/10 px-3 py-1.5 rounded-full mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)]"></span>
        {badge}
      </div>
      <h2 class="font-bold text-3xl md:text-4xl mb-5 leading-tight max-w-3xl">
        {h2}
      </h2>
      <p class="text-[var(--color-gray-1)] text-lg leading-relaxed max-w-3xl mb-10">
        {lead}
      </p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-6 reveal-group">
        {cards.map((c) => (
          <div class="bg-[var(--color-gray-3)] rounded-2xl p-6 border border-[var(--color-gray-2)] card-hover">
            <span class="inline-flex w-11 h-11 rounded-xl bg-[var(--color-accent)]/10 text-[var(--color-accent)] items-center justify-center mb-4">
              <Icon name={c.icon} size={22} />
            </span>
            <div class="font-bold text-[var(--color-primary)] mb-2 leading-snug">{c.title}</div>
            <div class="text-[var(--color-gray-1)] text-sm leading-relaxed">{c.desc}</div>
          </div>
        ))}
      </div>

      <div class="rounded-2xl bg-[var(--color-primary)] text-white p-7 md:p-8 flex flex-col md:flex-row md:items-center gap-6">
        <div class="md:flex-1">
          <div class="font-bold text-xl mb-1.5">{cta.title}</div>
          <p class="text-white/70 text-sm leading-relaxed max-w-xl">{cta.desc}</p>
        </div>
        <a
          href="#form"
          class="shrink-0 inline-flex items-center justify-center gap-2 bg-[var(--color-accent)] hover:bg-[var(--color-accent-light)] transition px-7 py-3.5 rounded-xl font-semibold text-white"
        >
          {cta.label}
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>
  </div>
</section>
