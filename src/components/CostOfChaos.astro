---
import Icon from "./Icon.astro";
import { content } from "../data/content.ts";

const { eyebrow, h2, lead, chains } = content.cost;
---

<section id="cost" class="bg-[var(--color-gray-3)]">
  <div class="mx-auto max-w-[1600px] px-6 py-20 md:py-24">
    <div class="reveal max-w-3xl mx-auto text-center mb-12">
      <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-3 font-medium">{eyebrow}</div>
      <h2 class="font-bold text-3xl md:text-4xl mb-5 leading-tight">
        {h2}
      </h2>
      <p class="text-[var(--color-gray-1)] text-lg leading-relaxed">
        {lead}
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-4 reveal-group">
      {chains.map((c) => (
        <div class="bg-white rounded-2xl p-6 border border-[var(--color-gray-2)] card-hover">
          <div class="flex items-center gap-2.5 mb-4">
            <span class="inline-flex w-9 h-9 rounded-xl bg-[var(--color-accent)]/10 text-[var(--color-accent)] items-center justify-center shrink-0">
              <Icon name="alert-triangle" size={18} />
            </span>
            <div class="font-bold text-[var(--color-primary)]">{c.title}</div>
          </div>
          <div class="flex flex-wrap items-center gap-x-1.5 gap-y-2 text-sm leading-snug">
            {c.steps.map((s, i) => (
              <>
                <span class={i === c.steps.length - 1 ? "text-[var(--color-accent)] font-medium" : "text-[var(--color-gray-1)]"}>{s}</span>
                {i < c.steps.length - 1 && (
                  <span class="text-[var(--color-gray-2)] shrink-0"><Icon name="arrow-right" size={14} /></span>
                )}
              </>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
