---
import Icon from "./Icon.astro";
import CityPattern from "./CityPattern.astro";
import { asset } from "../utils/asset";
import { content } from "../data/content.ts";

const h = content.hero;
---

<section id="hero" class="bg-[var(--color-primary)] text-white overflow-hidden relative sec-fade-bottom" style="--fade-color: var(--color-gray-3)">
  <CityPattern className="hero-pattern" />
  <div class="mx-auto max-w-[1400px] px-6 pt-6 pb-16 md:pt-8 md:pb-24 relative">

    <!-- Top nav -->
    <nav class="flex items-center justify-between mb-12 md:mb-14">
      <a href="#hero" class="flex flex-col items-center gap-0.5 leading-none">
        <img src={asset("/logo-pulse.png")} alt="" class="h-9 w-auto" aria-hidden="true" />
        <span class="font-bold uppercase tracking-[0.3em] text-sm pl-[0.3em] translate-x-[3px]">Puls</span>
      </a>
      <div class="hidden md:flex items-center gap-7 text-sm text-white/70">
        <a href="#what" class="hover:text-white transition">Что такое Puls</a>
        <a href="#dashboard" class="hover:text-white transition">Дашборд</a>
        <a href="#roles" class="hover:text-white transition">Роли</a>
        <a href="#pilot" class="hover:text-white transition">Условия пилота</a>
        <a href="#form" class="hover:text-white transition">Заявка</a>
      </div>
      <a href="#form" class="inline-flex items-center gap-2 bg-[var(--color-accent)] hover:opacity-90 transition px-5 py-2.5 rounded-xl font-medium text-sm">
        {h.ctaPrimary}
      </a>
    </nav>

    <!-- Hero content -->
    <div class="grid md:grid-cols-[1.1fr_1fr] gap-12 md:gap-10 items-center">
      <div class="reveal">
        <div class="inline-flex items-center gap-2 text-xs uppercase tracking-widest text-[var(--color-accent-light)] mb-6">
          <span class="inline-block w-2 h-2 rounded-full bg-[var(--color-accent-light)]"></span>
          {h.badge}
        </div>

        <h1 class="font-black text-[38px] sm:text-5xl md:text-6xl lg:text-[68px] leading-[1.05] sm:leading-[1.03] tracking-tight mb-6">
          {h.h1Line1}<br/>
          {h.h1Line2}<br/>
          <span class="text-[var(--color-accent-light)]">{h.h1Accent}</span>
        </h1>

        <p class="text-lg text-white/70 leading-relaxed max-w-xl mb-8">
          {h.lead}
        </p>

        <div class="flex flex-wrap gap-3 mb-10">
          <a href="#form" class="inline-flex items-center gap-2 bg-[var(--color-accent)] hover:opacity-90 transition px-6 py-3 rounded-xl font-medium">
            {h.ctaPrimary}
            <Icon name="arrow-right" size={18} />
          </a>
          <a href="#dashboard" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/15 transition px-6 py-3 rounded-xl font-medium border border-white/15">
            {h.ctaSecondary}
          </a>
        </div>

        <div class="flex flex-wrap items-center gap-x-7 gap-y-2 text-sm text-white/60">
          {h.bullets.map((b) => (
            <span class="inline-flex items-center gap-2"><Icon name="check" size={14} /> {b}</span>
          ))}
        </div>
      </div>

      <div class="reveal">
        <div class="hero-visual relative rounded-2xl overflow-hidden border border-white/10 shadow-2xl bg-white/5">
          <img
            src={asset("/figma/screen-yura-objekt.webp")}
            alt={h.screenAlt}
            loading="eager"
            fetchpriority="high"
            data-zoomable
            class="w-full h-auto block cursor-zoom-in"
          />
          <span class="zoom-hint">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3M11 8v6M8 11h6"/></svg>
            крупнее
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
