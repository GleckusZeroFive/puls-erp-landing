---
import Icon from "./Icon.astro";
import CityPattern from "./CityPattern.astro";
import { asset } from "../utils/asset";
---

<section id="hero" class="bg-[var(--color-primary)] text-white overflow-hidden relative">
  <CityPattern className="hero-pattern" />
  <div class="mx-auto max-w-6xl px-6 pt-24 pb-20 md:pt-32 md:pb-28 relative">

    <!-- Top nav -->
    <nav class="flex items-center justify-between mb-16 md:mb-20">
      <a href="#hero" class="flex flex-col items-center gap-0.5 leading-none">
        <img src={asset("/logo-pulse.png")} alt="" class="h-9 w-auto" aria-hidden="true" />
        <span class="font-bold uppercase tracking-[0.3em] text-sm pl-[0.3em] translate-x-[2px]">Pulse</span>
      </a>
      <div class="hidden md:flex items-center gap-7 text-sm text-white/70">
        <a href="#what" class="hover:text-white transition">Что такое Pulse</a>
        <a href="#dashboard" class="hover:text-white transition">Дашборд</a>
        <a href="#roles" class="hover:text-white transition">Роли</a>
        <a href="#pilot" class="hover:text-white transition">Условия пилота</a>
        <a href="#form" class="hover:text-white transition">Заявка</a>
      </div>
      <a href="#form" class="inline-flex items-center gap-2 bg-[var(--color-accent)] hover:opacity-90 transition px-5 py-2.5 rounded-xl font-medium text-sm">
        Подать заявку в пилот
      </a>
    </nav>

    <!-- Hero content -->
    <div class="grid md:grid-cols-[1.1fr_1fr] gap-12 md:gap-10 items-center">
      <div class="reveal">
        <div class="inline-flex items-center gap-2 text-xs uppercase tracking-widest text-[var(--color-accent-light)] mb-6">
          <span class="inline-block w-2 h-2 rounded-full bg-[var(--color-accent-light)]"></span>
          Предзапуск · набор 5–10 компаний в пилот
        </div>

        <h1 class="font-black text-4xl md:text-[52px] leading-[1.05] tracking-tight mb-6">
          Видеть, что происходит<br/>
          на объектах —<br/>
          <span class="text-[var(--color-accent-light)]">до того, как стало пожаром</span>
        </h1>

        <p class="text-lg text-white/70 leading-relaxed max-w-xl mb-8">
          Pulse — оперативный пульт управления стройкой: где горят сроки, где зависли
          материалы, кому платить и какие документы не закрыты по 10+ объектам сразу. Без ручного
          сбора данных из чатов, таблиц и звонков. Деньги теряются не из-за отсутствия заказов,
          а из-за того, что проблемы видно слишком поздно.
        </p>

        <div class="flex flex-wrap gap-3 mb-10">
          <a href="#form" class="inline-flex items-center gap-2 bg-[var(--color-accent)] hover:opacity-90 transition px-6 py-3 rounded-xl font-medium">
            Подать заявку в пилот
            <Icon name="arrow-right" size={18} />
          </a>
          <a href="#dashboard" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/15 transition px-6 py-3 rounded-xl font-medium border border-white/15">
            Смотреть дашборд
          </a>
        </div>

        <div class="flex flex-wrap items-center gap-x-7 gap-y-2 text-sm text-white/60">
          <span class="inline-flex items-center gap-2"><Icon name="check" size={14} /> Ранний доступ для первых компаний</span>
          <span class="inline-flex items-center gap-2"><Icon name="check" size={14} /> Настройка под ваши процессы</span>
        </div>
      </div>

      <div class="reveal">
        <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl bg-white/5">
          <img
            src={asset("/figma/screen-yura-objekt.webp")}
            alt="Главный экран Pulse — карточка объекта ЖК «Альянс»"
            loading="eager"
            class="w-full h-auto block"
          />
        </div>
      </div>
    </div>
  </div>
</section>
