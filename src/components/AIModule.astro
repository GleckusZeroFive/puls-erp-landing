---
import Icon from "./Icon.astro";
import { content } from "../data/content.ts";

const { eyebrow, h2, lead, badge, noticedLabel, actionLabel, principles, tabsIntro, items: aiRisks } = content.ai;
---

<section id="ai" class="relative overflow-hidden bg-[var(--color-primary)] text-white sec-fade-top sec-fade-bottom" style="--fade-color: var(--color-gray-3)">
  <div class="relative mx-auto max-w-[1600px] px-6 py-20 md:py-24" data-switch="ai">
    <div class="reveal max-w-3xl mx-auto text-center mb-8">
      <div class="text-xs uppercase tracking-widest text-[var(--color-accent-light)] mb-3 font-medium">{eyebrow}</div>
      <h2 class="font-bold text-3xl md:text-4xl mb-5 leading-tight">
        {h2}
      </h2>
      <p class="text-white/70 text-lg leading-relaxed">
        {lead}
      </p>
    </div>

    <!-- Три карты-принципа доверия к ассистенту -->
    <div class="grid sm:grid-cols-3 gap-4 mb-12 reveal-group">
      {principles.map((p) => (
        <div class="bg-white/5 rounded-2xl p-6 border border-white/10 card-hover">
          <span class="inline-flex w-11 h-11 rounded-xl bg-[var(--color-accent-light)]/15 text-[var(--color-accent-light)] items-center justify-center mb-4">
            <Icon name={p.icon} size={22} />
          </span>
          <div class="font-bold text-lg mb-3 leading-snug">{p.title}</div>
          <ul class="space-y-2">
            {p.points.map((pt) => (
              <li class="flex gap-2.5 text-white/65 text-sm leading-relaxed">
                <Icon name="check" size={16} class="mt-0.5 shrink-0 text-[var(--color-accent-light)]" />
                <span>{pt}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="reveal max-w-3xl mx-auto text-center mb-8">
      <h3 class="font-bold text-2xl md:text-3xl mb-3 leading-tight">{tabsIntro.h3}</h3>
      <p class="text-white/60 leading-relaxed">{tabsIntro.sub}</p>
    </div>

    <div class="grid lg:grid-cols-[300px_1fr] gap-6">
      <div class="reveal">
        <div class="flex flex-col gap-2" data-tabwrap role="tablist" aria-label={tabsIntro.h3}>
          {aiRisks.map((r, i) => (
            <button
              type="button"
              role="tab"
              data-tab={r.id}
              aria-selected={i === 0 ? "true" : "false"}
              class={`tab-btn-dark text-left rounded-2xl px-5 py-4 border transition ${i === 0 ? "is-active" : ""}`}
            >
              <div class="flex items-center gap-3">
                <span class="inline-flex w-9 h-9 rounded-xl bg-white/10 items-center justify-center shrink-0">
                  <Icon name={r.icon} size={18} />
                </span>
                <div>
                  <div class="font-semibold text-[15px] leading-tight">{r.tab}</div>
                  <div class="text-white/55 text-xs mt-0.5 leading-snug">{r.hint}</div>
                </div>
              </div>
            </button>
          ))}
        </div>
      </div>

      <div class="switch-stack reveal">
        {aiRisks.map((r, i) => (
          <div class={i === 0 ? "is-active" : ""} data-pane={r.id}>
            <div class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 h-full">
              <div class="inline-flex items-center gap-2 text-[11px] uppercase tracking-widest font-semibold text-[var(--color-accent-light)] bg-[var(--color-accent-light)]/15 px-2.5 py-1 rounded-full mb-5">
                {badge}
              </div>
              <div class="text-xs uppercase tracking-widest text-white/50 mb-2 font-medium">{noticedLabel}</div>
              <p class="text-white/90 text-[17px] leading-relaxed mb-7">{r.noticed}</p>
              <div class="text-xs uppercase tracking-widest text-white/50 mb-3 font-medium">{actionLabel}</div>
              <div class="flex flex-wrap gap-3">
                {r.action.split(" · ").map((a, idx) => (
                  <span class={`inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-medium ${idx === 0 ? "bg-[var(--color-accent)] text-white" : "bg-white/10 text-white border border-white/15"}`}>
                    {a}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .tab-btn-dark {
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.04);
    color: #fff;
    cursor: pointer;
  }
  .tab-btn-dark:hover {
    background-color: rgba(255, 255, 255, 0.08);
  }
  .tab-btn-dark.is-active {
    border-color: var(--color-accent-light);
    background-color: rgba(94, 149, 255, 0.14);
  }
</style>
