---
interface Props {
  num: string;
  title: string;
  bg: "primary" | "bg" | "accent" | "white";
  height?: string;
}
const { num, title, bg, height = "auto" } = Astro.props;
const bgClass: Record<string, string> = {
  primary: "bg-[var(--color-primary)] text-white",
  bg:      "bg-[var(--color-gray-3)] text-[var(--color-primary)]",
  accent:  "bg-[var(--color-accent)] text-white",
  white:   "bg-white text-[var(--color-primary)]",
};
const borderClass: Record<string, string> = {
  primary: "border-white/10",
  bg:      "border-[var(--color-gray-2)]",
  accent:  "border-white/15",
  white:   "border-[var(--color-gray-2)]",
};
const labelClass: Record<string, string> = {
  primary: "text-white/50",
  bg:      "text-[var(--color-gray-1)]",
  accent:  "text-white/70",
  white:   "text-[var(--color-gray-1)]",
};
---

<div class={`${bgClass[bg]} border-b ${borderClass[bg]} relative`}>
  <div class="mx-auto max-w-5xl px-6 py-12 md:py-16" style={`min-height: ${height};`}>
    <div class={`flex items-center gap-3 mb-6 text-xs uppercase tracking-widest ${labelClass[bg]}`}>
      <span class="font-mono">{num} / 08</span>
      <span class="opacity-30">·</span>
      <span>{title}</span>
    </div>
    <slot />
  </div>
</div>
