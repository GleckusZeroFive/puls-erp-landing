---
import Icon from "./Icon.astro";
import TabSwitch from "./TabSwitch.astro";
import { usecases } from "../data/usecases.ts";

const tabs = usecases.map((u) => ({ id: u.id, label: u.tab }));
---

<section id="scenarios" class="bg-white">
  <div class="mx-auto max-w-6xl px-6 py-20 md:py-24" data-switch="scenarios">
    <div class="reveal max-w-3xl mb-8">
      <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-3 font-medium">Сценарии</div>
      <h2 class="font-bold text-3xl md:text-4xl mb-5 leading-tight">
        Как Puls меняет типичные ситуации в подрядной компании
      </h2>
      <p class="text-[var(--color-gray-1)] text-lg leading-relaxed">
        Не абстрактные функции, а конкретные ситуации, на которых подрядчик теряет деньги.
      </p>
    </div>

    <div class="reveal mb-8">
      <TabSwitch tabs={tabs} variant="pill" label="Сценарий" />
    </div>

    <div class="switch-stack reveal">
      {usecases.map((u, i) => (
        <div class={i === 0 ? "is-active" : ""} data-pane={u.id}>
          <div class="grid md:grid-cols-2 gap-5">
            <div class="bg-[var(--color-gray-3)] rounded-2xl p-7 border border-[var(--color-gray-2)]">
              <div class="inline-flex items-center gap-2 text-xs uppercase tracking-widest font-semibold text-[var(--color-gray-1)] mb-4">
                <span class="w-2 h-2 rounded-full bg-[var(--color-danger)]"></span>
                Было — ручной хаос
              </div>
              <p class="text-[var(--color-primary)] leading-relaxed">{u.before}</p>
            </div>
            <div class="bg-[var(--color-primary)] text-white rounded-2xl p-7">
              <div class="inline-flex items-center gap-2 text-xs uppercase tracking-widest font-semibold text-[var(--color-accent-light)] mb-4">
                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-[var(--color-accent-light)]/20 text-[var(--color-accent-light)]"><Icon name="check" size={12} /></span>
                Стало — с Puls
              </div>
              <p class="text-white/90 leading-relaxed">{u.after}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
