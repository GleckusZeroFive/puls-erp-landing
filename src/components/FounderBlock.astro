---
import { asset } from "../utils/asset";
import { content } from "../data/content.ts";

const { eyebrow, h2, lead, benefits, quoteLabel, quote, name, role, photoAlt } = content.founder;
---

<section id="founder" class="bg-white">
  <div class="mx-auto max-w-[1400px] px-6 py-20 md:py-24">
    <div class="reveal max-w-3xl mx-auto text-center mb-12">
      <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-3 font-medium">{eyebrow}</div>
      <h2 class="font-bold text-3xl md:text-4xl mb-5 leading-tight">
        {h2}
      </h2>
      <p class="text-[var(--color-gray-1)] text-lg leading-relaxed">
        {lead}
      </p>
    </div>

    <div class="grid lg:grid-cols-[1fr_1.1fr] gap-6 items-stretch reveal">
      <div class="grid gap-4">
        {benefits.map((b) => (
          <div class="bg-[var(--color-gray-3)] rounded-2xl p-6 border border-[var(--color-gray-2)] flex gap-4 card-hover">
            <div class="font-black text-2xl text-[var(--color-accent)] leading-none shrink-0">{b.num}</div>
            <div>
              <div class="font-bold text-lg text-[var(--color-primary)] mb-1.5">{b.title}</div>
              <div class="text-[var(--color-gray-1)] leading-relaxed">{b.desc}</div>
            </div>
          </div>
        ))}
      </div>

      <div class="bg-[var(--color-primary)] text-white rounded-2xl p-8 md:p-10 flex flex-col">
        <div class="text-xs uppercase tracking-widest text-[var(--color-accent-light)] mb-4 font-medium">{quoteLabel}</div>
        <p class="text-xl md:text-2xl leading-relaxed font-medium mb-8">
          {quote}
        </p>
        <div class="mt-auto flex items-center gap-4 pt-6 border-t border-white/15">
          <img src={asset("/figma/founder-artem.webp")} alt={photoAlt} class="w-12 h-12 rounded-full object-cover shrink-0" />
          <div>
            <div class="font-semibold">{name}</div>
            <div class="text-white/60 text-sm">{role}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
