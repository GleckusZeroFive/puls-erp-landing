---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import PulseDashboard from "../components/PulseDashboard.astro";
import CityPattern from "../components/CityPattern.astro";
import ContactForm from "../components/ContactForm.astro";
import CostOfChaos from "../components/CostOfChaos.astro";
import WhatIsPuls from "../components/WhatIsPuls.astro";
import RoleSwitcher from "../components/RoleSwitcher.astro";
import AIModule from "../components/AIModule.astro";
import ToolsCompare from "../components/ToolsCompare.astro";
import ScenarioTabs from "../components/ScenarioTabs.astro";
import FounderBlock from "../components/FounderBlock.astro";
import TrustMetrics from "../components/TrustMetrics.astro";
import AudienceFilter from "../components/AudienceFilter.astro";
import PilotTerms from "../components/PilotTerms.astro";
import FAQ from "../components/FAQ.astro";

const pains = [
  { num: "01", icon: "package",        title: "Хаос в снабжении",            desc: "Заявки на материалы летят в Telegram, Excel и голосовыми. Снабжение не видит, к какому сроку материал критичен для графика." },
  { num: "02", icon: "hard-hat",       title: "«Всё нормально» от прораба",   desc: "Прораб уверяет, что идём по плану, а ключевой этап сорван неделю назад — бригада простаивает без комплектующих." },
  { num: "03", icon: "file-signature", title: "Забытые допработы",            desc: "ПТО не успевает зафиксировать письма, акты и КС. Лишний объём выполнен за свой счёт и юридически не закреплён." },
  { num: "04", icon: "credit-card",    title: "Слепые согласования оплат",    desc: "Вы согласовываете оплаты вслепую, не зная, выполнен ли реальный объём — и не платите ли авансом сверх факта." },
  { num: "05", icon: "table",          title: "1С не показывает оперативность", desc: "1С хранит бухучёт, но не покажет в 9:00 утра, какие три проблемы горят прямо сейчас и затормозят стройку." },
  { num: "06", icon: "trending-down",  title: "Позднее прозрение",            desc: "Объект тихо уходит в минус. Финансовый результат вы узнаёте после закрытия, когда исправить уже нельзя." },
];

const steps = [
  { num: "01", title: "Короткий аудит-звонок", desc: "Связываемся за 15 минут в Telegram. Уточняем: сколько объектов ведёте параллельно, какие роли в штате, где учёт у снабжения и ПТО, что болит сильнее всего." },
  { num: "02", title: "Демо-показ «Пульса»",   desc: "Показываем интерфейс на реальных кейсах: как прораб отправляет заявку, как помощник готовит черновик письма и как вы видите маржинальность." },
  { num: "03", title: "Запуск первого контура", desc: "Если понимаем, что PULS даёт окупаемость — согласуем первый пилотный контур на 2 тестовых объектах и внедряем без остановки стройки." },
];
---

<Layout>

  <!-- 01 · HERO -->
  <Hero />

  <!-- 02 · PROBLEM -->
  <section id="problem" class="bg-[var(--color-gray-3)]">
    <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
      <div class="reveal max-w-3xl mb-12">
        <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-3 font-medium">Знакомая картина?</div>
        <h2 class="font-bold text-3xl md:text-4xl mb-5 leading-tight">
          Когда объектов становится 10+, Excel и чаты начинают прятать убытки
        </h2>
        <p class="text-[var(--color-gray-1)] text-lg leading-relaxed">
          Контроль уходит не за один день, а постепенно: одно сообщение потерялось, одну заявку
          забыли, один акт не подписали, материал заказали поздно, допработу не зафиксировали.
          А потом объект вроде сделан — но прибыль куда-то исчезла.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 reveal">
        {pains.map((item) => (
          <div class="bg-white rounded-2xl p-6 border border-[var(--color-gray-2)] hover:border-[var(--color-accent)]/40 transition">
            <div class="flex items-center gap-3 mb-3">
              <span class="font-black text-[var(--color-gray-2)] text-lg leading-none">{item.num}</span>
              <span class="inline-flex w-10 h-10 rounded-xl bg-[var(--color-accent)]/10 text-[var(--color-accent)] items-center justify-center">
                <Icon name={item.icon} size={20} />
              </span>
            </div>
            <div class="font-bold text-[var(--color-primary)] mb-2 leading-snug">{item.title}</div>
            <div class="text-[var(--color-gray-1)] text-sm leading-relaxed">{item.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 · ЦЕНА РУЧНОГО УПРАВЛЕНИЯ -->
  <CostOfChaos />

  <!-- 04 · ЧТО ТАКОЕ PULS -->
  <WhatIsPuls />

  <!-- 05 · ПУЛЬС КОМПАНИИ (дашборд, 5 модулей) -->
  <section id="dashboard" class="bg-white">
    <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
      <div class="reveal max-w-3xl mb-12">
        <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-3 font-medium">Пульс компании</div>
        <h2 class="font-bold text-3xl md:text-4xl mb-5 leading-tight">
          Пульс компании сегодня — кликните, чтобы проверить в действии
        </h2>
        <p class="text-[var(--color-gray-1)] text-lg leading-relaxed">
          Один экран показывает разные участки контроля: объекты в риске, согласование оплат,
          материалы, документы и сводку помощника. Переключатель сверху — живой, попробуйте.
        </p>
      </div>

      <div class="reveal">
        <PulseDashboard />
      </div>
    </div>
  </section>

  <!-- 06 · РОЛИ НА СТРОЙКЕ -->
  <RoleSwitcher />

  <!-- 07 · ИИ-МОДУЛЬ -->
  <AIModule />

  <!-- 08 · СРАВНЕНИЕ ИНСТРУМЕНТОВ -->
  <ToolsCompare />

  <!-- 09 · СЦЕНАРИИ БЫЛО/СТАЛО -->
  <ScenarioTabs />

  <!-- 10 · ЛИЧНЫЕ ВЫГОДЫ + ЦИТАТА -->
  <FounderBlock />

  <!-- 11 · ДОВЕРИЕ / ОПЫТ -->
  <TrustMetrics />

  <!-- 12 · ФИЛЬТРАЦИЯ ЦА -->
  <AudienceFilter />

  <!-- 13 · УСЛОВИЯ ПИЛОТА -->
  <PilotTerms />

  <!-- 14 · 3 ШАГА ДО ЗАПУСКА -->
  <section id="steps" class="bg-white">
    <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
      <div class="reveal max-w-3xl mb-14">
        <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-3 font-medium">Прозрачный процесс</div>
        <h2 class="font-bold text-3xl md:text-4xl mb-5 leading-tight">
          3 шага до запуска пилота — без давления и навязывания
        </h2>
        <p class="text-[var(--color-gray-1)] text-lg leading-relaxed">
          Мы понимаем, как раздражают менеджеры по продажам IT-сервисов. Поэтому процесс построен
          на честной диагностике и строительной логике.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 reveal">
        {steps.map((s) => (
          <div class="bg-[var(--color-gray-3)] rounded-2xl p-7 border border-[var(--color-gray-2)]">
            <div class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-[var(--color-accent)] text-white font-bold text-lg mb-5">{s.num}</div>
            <div class="font-bold text-xl mb-3 leading-snug text-[var(--color-primary)]">{s.title}</div>
            <div class="text-[var(--color-gray-1)] leading-relaxed">{s.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 15 · FAQ -->
  <FAQ />

  <!-- 16 · ФИНАЛЬНЫЙ CTA + ФОРМА -->
  <section id="form" class="relative overflow-hidden bg-[var(--color-primary)] text-white">
    <CityPattern opacity={0.1} />
    <div class="relative mx-auto max-w-6xl px-6 py-20 md:py-24">
      <div class="grid md:grid-cols-2 gap-10 items-start">
        <div class="reveal">
          <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-3 font-medium">Финальный шаг к контролю стройки</div>
          <h2 class="font-black text-3xl md:text-4xl leading-tight mb-5">
            Подайте заявку на пилотный доступ в PULS
          </h2>
          <p class="text-white/70 leading-relaxed mb-8 max-w-lg">
            Свяжемся в течение рабочего дня, разберём ваши процессы на стройке, покажем
            демо-сценарий и определим, подходит ли ваша компания под условия пилота.
          </p>
          <div class="flex flex-wrap gap-2 text-xs text-white/50">
            <span class="bg-white/10 px-2 py-1 rounded">Не звоним без запроса</span>
            <span class="bg-white/10 px-2 py-1 rounded">Не передаём данные третьим лицам</span>
          </div>
        </div>

        <div class="reveal">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
