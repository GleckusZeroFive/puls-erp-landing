---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="min-h-screen flex items-center justify-center bg-[var(--color-bg)]">
    <div class="max-w-xl px-6 py-20 text-center">
      <img src="/logo-vertical.png" alt="PULS ERP" class="h-24 w-auto mx-auto mb-8" />
      <h1 class="font-black text-3xl md:text-4xl text-[var(--color-primary)] mb-4">PULS ERP</h1>
      <p class="text-[var(--color-gray-1)] leading-relaxed">
        Сайт в разработке.
      </p>
    </div>
  </main>
</Layout>
