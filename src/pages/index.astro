---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import ProductScreens from "../components/ProductScreens.astro";
import CityPattern from "../components/CityPattern.astro";
import ContactForm from "../components/ContactForm.astro";
import CostOfChaos from "../components/CostOfChaos.astro";
import WhatIsPuls from "../components/WhatIsPuls.astro";
import RoleSwitcher from "../components/RoleSwitcher.astro";
import AIModule from "../components/AIModule.astro";
import ProtectionBlock from "../components/ProtectionBlock.astro";
import ToolsCompare from "../components/ToolsCompare.astro";
import ScenarioTabs from "../components/ScenarioTabs.astro";
import FounderBlock from "../components/FounderBlock.astro";
import TrustMetrics from "../components/TrustMetrics.astro";
import AudienceFilter from "../components/AudienceFilter.astro";
import PilotTerms from "../components/PilotTerms.astro";
import FAQ from "../components/FAQ.astro";
import StickyHeader from "../components/StickyHeader.astro";
import { content } from "../data/content.ts";

const pains = content.problem.items;
const steps = content.steps.items;
---

<Layout>

  <StickyHeader />

  <!-- 01 · HERO -->
  <Hero />

  <!-- 02 · PROBLEM -->
  <section id="problem" class="bg-[var(--color-gray-3)]">
    <div class="mx-auto max-w-[1400px] px-6 py-20 md:py-24">
      <div class="reveal max-w-3xl mx-auto text-center mb-12">
        <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-3 font-medium">{content.problem.eyebrow}</div>
        <h2 class="font-bold text-3xl md:text-4xl mb-5 leading-tight">
          {content.problem.h2}
        </h2>
        <p class="text-[var(--color-gray-1)] text-lg leading-relaxed">
          {content.problem.lead}
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 reveal-group">
        {pains.map((item) => (
          <div class="bg-white rounded-2xl p-6 border border-[var(--color-gray-2)] card-hover">
            <div class="flex items-center gap-3 mb-3">
              <span class="font-black text-[var(--color-gray-2)] text-lg leading-none">{item.num}</span>
              <span class="inline-flex w-10 h-10 rounded-xl bg-[var(--color-accent)]/10 text-[var(--color-accent)] items-center justify-center">
                <Icon name={item.icon} size={20} />
              </span>
            </div>
            <div class="font-bold text-[var(--color-primary)] mb-2 leading-snug">{item.title}</div>
            <div class="text-[var(--color-gray-1)] text-sm leading-relaxed">{item.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 · ЦЕНА РУЧНОГО УПРАВЛЕНИЯ -->
  <CostOfChaos />

  <!-- 04 · ЧТО ТАКОЕ Puls -->
  <WhatIsPuls />

  <!-- 05 · ПУЛЬС КОМПАНИИ (дашборд, 5 модулей) -->
  <section id="dashboard" class="bg-white">
    <div class="mx-auto max-w-[1400px] px-6 py-20 md:py-24">
      <div class="reveal max-w-3xl mx-auto text-center mb-12">
        <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-3 font-medium">{content.dashboard.eyebrow}</div>
        <h2 class="font-bold text-3xl md:text-4xl mb-5 leading-tight">
          {content.dashboard.h2}
        </h2>
        <p class="text-[var(--color-gray-1)] text-lg leading-relaxed">
          {content.dashboard.lead}
        </p>
      </div>

      <div class="reveal">
        <ProductScreens />
      </div>
    </div>
  </section>

  <!-- 06 · РОЛИ НА СТРОЙКЕ -->
  <RoleSwitcher />

  <!-- 07 · ИИ-МОДУЛЬ -->
  <AIModule />

  <!-- 08 · СРАВНЕНИЕ ИНСТРУМЕНТОВ -->
  <ToolsCompare />

  <!-- 08b · ВАША ЗАЩИТА -->
  <ProtectionBlock />

  <!-- 09 · СЦЕНАРИИ БЫЛО/СТАЛО -->
  <ScenarioTabs />

  <!-- 10 · ЛИЧНЫЕ ВЫГОДЫ + ЦИТАТА -->
  <FounderBlock />

  <!-- 11 · ДОВЕРИЕ / ОПЫТ -->
  <TrustMetrics />

  <!-- 12 · ФИЛЬТРАЦИЯ ЦА -->
  <AudienceFilter />

  <!-- 13 · УСЛОВИЯ ПИЛОТА -->
  <PilotTerms />

  <!-- 14 · 3 ШАГА ДО ЗАПУСКА -->
  <section id="steps" class="bg-white">
    <div class="mx-auto max-w-[1400px] px-6 py-20 md:py-24">
      <div class="reveal max-w-3xl mx-auto text-center mb-14">
        <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-3 font-medium">{content.steps.eyebrow}</div>
        <h2 class="font-bold text-3xl md:text-4xl mb-5 leading-tight">
          {content.steps.h2}
        </h2>
        <p class="text-[var(--color-gray-1)] text-lg leading-relaxed">
          {content.steps.lead}
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 reveal-group">
        {steps.map((s) => (
          <div class="bg-[var(--color-gray-3)] rounded-2xl p-7 border border-[var(--color-gray-2)] card-hover">
            <div class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-[var(--color-accent)] text-white font-bold text-lg mb-5">{s.num}</div>
            <div class="font-bold text-xl mb-3 leading-snug text-[var(--color-primary)]">{s.title}</div>
            <div class="text-[var(--color-gray-1)] leading-relaxed">{s.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 15 · FAQ -->
  <FAQ />

  <!-- 16 · ФИНАЛЬНЫЙ CTA + ФОРМА -->
  <section id="form" class="relative overflow-hidden bg-[var(--color-primary)] text-white sec-fade-top" style="--fade-color: #ffffff">
    <CityPattern opacity={0.1} />
    <div class="relative mx-auto max-w-[1400px] px-6 py-20 md:py-24">
      <div class="grid md:grid-cols-2 gap-10 items-start">
        <div class="reveal">
          <div class="text-xs uppercase tracking-widest text-[var(--color-accent-light)] mb-3 font-medium">{content.formSection.eyebrow}</div>
          <h2 class="font-black text-3xl md:text-4xl leading-tight mb-5">
            {content.formSection.h2}
          </h2>
          <p class="text-white/70 leading-relaxed mb-8 max-w-lg">
            {content.formSection.lead}
          </p>
          <div class="flex flex-wrap gap-2 text-xs text-white/50">
            {content.formSection.chips.map((c) => (
              <span class="bg-white/10 px-2 py-1 rounded">{c}</span>
            ))}
          </div>
        </div>

        <div class="reveal">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
