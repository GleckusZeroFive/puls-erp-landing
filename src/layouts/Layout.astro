---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = "PULS ERP — управление строительным подрядом",
  description = "Система оперативного контроля строительного подряда. Объекты, материалы, оплаты, документы и риски — в одном экране, с AI-сводкой на каждое утро.",
  noindex = false,
} = Astro.props as Props;

const siteUrl = "https://puls-erp.ru/";
const ogImage = new URL("/figma/screen-dashboard-2.webp", siteUrl).toString();
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="PULS ERP" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#202F4D" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Onest:wght@300;400;500;600;700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="antialiased">
    <slot />
    <script is:inline>
      // Reveal-on-scroll — IntersectionObserver навешивает .is-visible на элементы с .reveal
      (() => {
        function init() {
          const items = document.querySelectorAll(".reveal");
          if (!items.length) return;

          if (!("IntersectionObserver" in window)) {
            items.forEach((el) => el.classList.add("is-visible"));
            return;
          }

          const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          }, { rootMargin: "0px 0px -10% 0px", threshold: 0.05 });

          items.forEach((el) => io.observe(el));
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init);
        } else {
          init();
        }
      })();
    </script>
    <script is:inline>
      // Generic tab switcher — обслуживает все [data-switch] блоки (dashboard / roles / ai / scenarios).
      // Клик по [data-tab] тогглит .is-active на кнопках и на [data-pane] внутри того же контейнера.
      (() => {
        function initSwitches() {
          document.querySelectorAll("[data-switch]").forEach((group) => {
            if (group.dataset.switchBound) return;
            group.dataset.switchBound = "1";
            const tabs = Array.from(group.querySelectorAll("[data-tab]"));
            const panes = Array.from(group.querySelectorAll("[data-pane]"));
            tabs.forEach((tab) => {
              tab.addEventListener("click", () => {
                const id = tab.getAttribute("data-tab");
                tabs.forEach((t) => {
                  const on = t === tab;
                  t.classList.toggle("is-active", on);
                  t.setAttribute("aria-selected", on ? "true" : "false");
                });
                panes.forEach((p) => {
                  p.classList.toggle("is-active", p.getAttribute("data-pane") === id);
                });
              });
            });
          });
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initSwitches);
        } else {
          initSwitches();
        }
      })();
    </script>
    <script is:inline>
      // Аккордеон <details> — плавная height-анимация + стаггер контента.
      // Перехватываем клик по summary, анимируем вручную через .details-body.
      (() => {
        const EASE = "cubic-bezier(0.16, 1, 0.3, 1)";
        const HEIGHT_MS = 380;
        const ITEM_MS = 520;
        const ITEM_STAGGER = 90;
        const ITEM_DELAY_START = 120;

        function pickItems(details) {
          const body = details.querySelector(":scope > .details-body");
          if (!body) return [];
          let cur = body;
          while (cur && cur.children.length === 1 && cur.firstElementChild.tagName === "DIV") {
            cur = cur.firstElementChild;
          }
          return Array.from(cur.children);
        }

        function resetItem(item) {
          item.style.transition = "none";
          item.style.opacity = "0";
          item.style.transform = "translateY(24px)";
        }

        function animateOpen(details) {
          const body = details.querySelector(":scope > .details-body");
          if (!body) return;
          const items = pickItems(details);
          items.forEach(resetItem);

          body.style.height = "auto";
          const target = body.scrollHeight;
          body.style.height = "0px";
          body.style.overflow = "hidden";
          body.style.transition = `height ${HEIGHT_MS}ms cubic-bezier(0.4, 0, 0.2, 1)`;

          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              body.style.height = target + "px";
              items.forEach((it, i) => {
                it.style.transition = `opacity ${ITEM_MS}ms ease, transform ${ITEM_MS}ms ${EASE}`;
                it.style.transitionDelay = (ITEM_DELAY_START + i * ITEM_STAGGER) + "ms";
                it.style.opacity = "1";
                it.style.transform = "translateY(0)";
              });
            });
          });

          body.addEventListener("transitionend", function onEnd(e) {
            if (e.propertyName !== "height") return;
            body.removeEventListener("transitionend", onEnd);
            body.style.height = "auto";
            body.style.overflow = "";
          });
        }

        function animateClose(details) {
          const body = details.querySelector(":scope > .details-body");
          if (!body) return;
          const items = pickItems(details);

          body.style.overflow = "hidden";
          body.style.height = body.scrollHeight + "px";
          void body.offsetHeight;
          body.style.transition = `height ${HEIGHT_MS}ms cubic-bezier(0.4, 0, 0.2, 1)`;

          details.setAttribute("open", "");

          requestAnimationFrame(() => {
            items.forEach((it) => {
              it.style.transition = "opacity 160ms ease, transform 200ms ease";
              it.style.transitionDelay = "0ms";
              it.style.opacity = "0";
              it.style.transform = "translateY(8px)";
            });
            body.style.height = "0px";
          });

          body.addEventListener("transitionend", function onEnd(e) {
            if (e.propertyName !== "height") return;
            body.removeEventListener("transitionend", onEnd);
            details.removeAttribute("open");
            body.style.height = "";
            body.style.overflow = "";
            body.style.transition = "";
          });
        }

        function bind(details) {
          if (details.dataset.animBound) return;
          details.dataset.animBound = "1";
          details.classList.add("js-anim-ready");

          const items = pickItems(details);
          items.forEach(resetItem);
          const body = details.querySelector(":scope > .details-body");
          if (body) {
            body.style.height = "0px";
            body.style.overflow = "hidden";
          }

          const summary = details.querySelector(":scope > summary");
          if (!summary) return;
          summary.addEventListener("click", (e) => {
            e.preventDefault();
            if (details.open) {
              animateClose(details);
            } else {
              details.setAttribute("open", "");
              animateOpen(details);
            }
          });
        }

        function initAccordion() {
          document.querySelectorAll("details").forEach(bind);
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initAccordion);
        } else {
          initAccordion();
        }
      })();
    </script>
  </body>
</html>
