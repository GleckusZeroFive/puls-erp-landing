---
import "../styles/global.css";
import Lightbox from "../components/Lightbox.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = "Puls — управление строительной подрядной компанией",
  description = "Система оперативного контроля строительной подрядной компании. Объекты, материалы, оплаты, документы и риски — в одном экране, с AI-сводкой на каждое утро.",
  noindex = false,
} = Astro.props as Props;

const siteUrl = "https://puls-erp.ru/";
const ogImage = new URL("/figma/screen-yura-objekt.webp", siteUrl).toString();
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Puls" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#202F4D" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Onest:wght@300;400;500;600;700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="antialiased">
    <slot />
    <Lightbox />
    <script is:inline>
      // Reveal-on-scroll — IntersectionObserver навешивает .is-visible на элементы с .reveal
      (() => {
        function init() {
          const items = document.querySelectorAll(".reveal, .reveal-group");
          if (!items.length) return;

          const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

          // случайный лёгкий наклон (−1.5…1.5°): при появлении в каскаде и при наведении
          if (!reduce) {
            const tilt = () => (Math.random() * 3 - 1.5).toFixed(2) + "deg";
            document.querySelectorAll(".reveal-group > *").forEach((c) => {
              c.style.setProperty("--reveal-tilt", tilt());
            });
            document.querySelectorAll(".card-hover").forEach((c) => {
              c.addEventListener("mouseenter", () => c.style.setProperty("--hover-tilt", tilt()));
            });
          }

          if (!("IntersectionObserver" in window)) {
            items.forEach((el) => el.classList.add("is-visible"));
            return;
          }

          const STAGGER = 70;
          const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target;
              el.classList.add("is-visible");
              // Каскад: transition-delay ставится inline на время входа и снимается после.
              if (!reduce && el.classList.contains("reveal-group")) {
                const kids = el.children;
                for (let i = 0; i < kids.length; i++) {
                  kids[i].style.transitionDelay = i * STAGGER + "ms";
                }
                setTimeout(() => {
                  for (let i = 0; i < kids.length; i++) kids[i].style.transitionDelay = "";
                }, kids.length * STAGGER + 700);
              }
              io.unobserve(el);
            });
          }, { rootMargin: "0px 0px -10% 0px", threshold: 0.05 });

          items.forEach((el) => io.observe(el));
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init);
        } else {
          init();
        }
      })();
    </script>
    <script is:inline>
      // Generic tab switcher — обслуживает все [data-switch] блоки (dashboard / roles / ai / scenarios).
      // Клик по [data-tab] тогглит .is-active на кнопках и на [data-pane] внутри того же контейнера.
      (() => {
        function initSwitches() {
          document.querySelectorAll("[data-switch]").forEach((group) => {
            if (group.dataset.switchBound) return;
            group.dataset.switchBound = "1";
            const tabs = Array.from(group.querySelectorAll("[data-tab]"));
            const panes = Array.from(group.querySelectorAll("[data-pane]"));
            tabs.forEach((tab) => {
              tab.addEventListener("click", () => {
                const id = tab.getAttribute("data-tab");
                tabs.forEach((t) => {
                  const on = t === tab;
                  t.classList.toggle("is-active", on);
                  t.setAttribute("aria-selected", on ? "true" : "false");
                });
                panes.forEach((p) => {
                  p.classList.toggle("is-active", p.getAttribute("data-pane") === id);
                });
              });
            });
          });
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initSwitches);
        } else {
          initSwitches();
        }
      })();
    </script>
    <script is:inline>
      // Аккордеон <details>: высоту анимирует CSS (grid-template-rows 0fr→1fr).
      // JS перехватывает клик по summary и тогглит [data-open]; нативный open держим всегда.
      (() => {
        function bind(details) {
          if (details.dataset.animBound) return;
          details.dataset.animBound = "1";
          details.classList.add("js-anim-ready");
          details.setAttribute("open", "");

          const summary = details.querySelector(":scope > summary");
          if (!summary) return;
          summary.addEventListener("click", (e) => {
            e.preventDefault();
            if (details.hasAttribute("data-open")) {
              details.removeAttribute("data-open");
            } else {
              details.setAttribute("data-open", "");
            }
          });
        }

        function initAccordion() {
          document.querySelectorAll("details").forEach(bind);
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initAccordion);
        } else {
          initAccordion();
        }
      })();
    </script>
    <script is:inline>
      // Count-up чисел [data-countup] при попадании в кадр (once).
      // Парсим «префикс + число + суффикс» (напр. «~600 млн ₽», «до 22», «19 лет»),
      // анимируем только число. prefers-reduced-motion → оставляем исходник.
      (() => {
        const els = document.querySelectorAll("[data-countup]");
        if (!els.length || !("IntersectionObserver" in window)) return;
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduce) return;

        function run(el) {
          const raw = el.textContent;
          const m = raw.match(/^(\D*?)(\d[\d\s]*\d|\d)(.*)$/s);
          if (!m) return;
          const prefix = m[1];
          const suffix = m[3];
          const target = parseInt(m[2].replace(/\s/g, ""), 10);
          if (isNaN(target)) return;
          const dur = 1300;
          const t0 = performance.now();
          el.textContent = prefix + "0" + suffix;
          function tick(now) {
            const p = Math.min(1, (now - t0) / dur);
            const eased = 1 - Math.pow(1 - p, 3);
            if (p < 1) {
              el.textContent = prefix + String(Math.round(target * eased)) + suffix;
              requestAnimationFrame(tick);
            } else {
              el.textContent = raw;
            }
          }
          requestAnimationFrame(tick);
        }

        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { run(e.target); io.unobserve(e.target); }
          });
        }, { threshold: 0.6 });
        els.forEach((el) => io.observe(el));
      })();
    </script>
    <script is:inline>
      // Мягкий край у горизонтальных лент [.scroll-x-fade]: ставит --ml/--mr по позиции
      // скролла, чтобы контент таял только там, где есть куда листать.
      (() => {
        const FADE = "22px";
        function upd(el) {
          const max = el.scrollWidth - el.clientWidth;
          el.style.setProperty("--ml", el.scrollLeft > 2 ? FADE : "0px");
          el.style.setProperty("--mr", el.scrollLeft < max - 2 ? FADE : "0px");
        }
        function init() {
          document.querySelectorAll(".scroll-x-fade").forEach((el) => {
            if (el.dataset.fadeBound) return;
            el.dataset.fadeBound = "1";
            upd(el);
            el.addEventListener("scroll", () => upd(el), { passive: true });
          });
        }
        const updAll = () => document.querySelectorAll(".scroll-x-fade").forEach(upd);
        window.addEventListener("resize", updAll);
        window.addEventListener("load", updAll);
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init);
        } else {
          init();
        }
      })();
    </script>
  </body>
</html>
