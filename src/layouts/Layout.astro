---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = "Puls — управление строительной подрядной компанией",
  description = "Система оперативного контроля строительной подрядной компании. Объекты, материалы, оплаты, документы и риски — в одном экране, с AI-сводкой на каждое утро.",
  noindex = false,
} = Astro.props as Props;

const siteUrl = "https://puls-erp.ru/";
const ogImage = new URL("/figma/screen-yura-objekt.webp", siteUrl).toString();
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Puls" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#202F4D" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Onest:wght@300;400;500;600;700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="antialiased">
    <slot />
    <script is:inline>
      // Reveal-on-scroll — IntersectionObserver навешивает .is-visible на элементы с .reveal
      (() => {
        function init() {
          const items = document.querySelectorAll(".reveal");
          if (!items.length) return;

          if (!("IntersectionObserver" in window)) {
            items.forEach((el) => el.classList.add("is-visible"));
            return;
          }

          const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          }, { rootMargin: "0px 0px -10% 0px", threshold: 0.05 });

          items.forEach((el) => io.observe(el));
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init);
        } else {
          init();
        }
      })();
    </script>
    <script is:inline>
      // Generic tab switcher — обслуживает все [data-switch] блоки (dashboard / roles / ai / scenarios).
      // Клик по [data-tab] тогглит .is-active на кнопках и на [data-pane] внутри того же контейнера.
      (() => {
        function initSwitches() {
          document.querySelectorAll("[data-switch]").forEach((group) => {
            if (group.dataset.switchBound) return;
            group.dataset.switchBound = "1";
            const tabs = Array.from(group.querySelectorAll("[data-tab]"));
            const panes = Array.from(group.querySelectorAll("[data-pane]"));
            tabs.forEach((tab) => {
              tab.addEventListener("click", () => {
                const id = tab.getAttribute("data-tab");
                tabs.forEach((t) => {
                  const on = t === tab;
                  t.classList.toggle("is-active", on);
                  t.setAttribute("aria-selected", on ? "true" : "false");
                });
                panes.forEach((p) => {
                  p.classList.toggle("is-active", p.getAttribute("data-pane") === id);
                });
              });
            });
          });
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initSwitches);
        } else {
          initSwitches();
        }
      })();
    </script>
    <script is:inline>
      // Аккордеон <details>: высоту анимирует CSS (grid-template-rows 0fr→1fr).
      // JS перехватывает клик по summary и тогглит [data-open]. Нативный open
      // держим всегда, чтобы контент оставался в потоке (схлопывает grid, не UA).
      (() => {
        function bind(details) {
          if (details.dataset.animBound) return;
          details.dataset.animBound = "1";
          details.classList.add("js-anim-ready");
          details.setAttribute("open", "");

          const summary = details.querySelector(":scope > summary");
          if (!summary) return;
          summary.addEventListener("click", (e) => {
            e.preventDefault();
            if (details.hasAttribute("data-open")) {
              details.removeAttribute("data-open");
            } else {
              details.setAttribute("data-open", "");
            }
          });
        }

        function initAccordion() {
          document.querySelectorAll("details").forEach(bind);
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initAccordion);
        } else {
          initAccordion();
        }
      })();
    </script>
  </body>
</html>
