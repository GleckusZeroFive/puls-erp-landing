---
import "../styles/global.css";
const { title = "PULS ERP — управление строительным подрядом" } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Onest:wght@300;400;500;600;700;900&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="antialiased">
    <slot />
    <script is:inline>
      (() => {
        const EASE = 'cubic-bezier(0.16, 1, 0.3, 1)';
        const HEIGHT_MS = 380;
        const ITEM_MS = 520;
        const ITEM_STAGGER = 90;
        const ITEM_DELAY_START = 120;

        function pickItems(details) {
          const body = details.querySelector(':scope > .details-body');
          if (!body) return [];
          // walk down through wrapper divs until we find real content children (p/ul/ol/etc)
          let cur = body;
          while (cur && cur.children.length === 1 && cur.firstElementChild.tagName === 'DIV') {
            cur = cur.firstElementChild;
          }
          return Array.from(cur.children);
        }

        function resetItem(item) {
          item.style.transition = 'none';
          item.style.opacity = '0';
          item.style.transform = 'translateY(24px)';
        }

        function animateOpen(details) {
          const body = details.querySelector(':scope > .details-body');
          if (!body) return;
          const items = pickItems(details);
          items.forEach(resetItem);

          // measure target height
          body.style.height = 'auto';
          const target = body.scrollHeight;
          body.style.height = '0px';
          body.style.overflow = 'hidden';
          body.style.transition = `height ${HEIGHT_MS}ms cubic-bezier(0.4, 0, 0.2, 1)`;

          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              body.style.height = target + 'px';
              items.forEach((it, i) => {
                it.style.transition = `opacity ${ITEM_MS}ms ease, transform ${ITEM_MS}ms ${EASE}`;
                it.style.transitionDelay = (ITEM_DELAY_START + i * ITEM_STAGGER) + 'ms';
                it.style.opacity = '1';
                it.style.transform = 'translateY(0)';
              });
            });
          });

          body.addEventListener('transitionend', function onEnd(e) {
            if (e.propertyName !== 'height') return;
            body.removeEventListener('transitionend', onEnd);
            body.style.height = 'auto';
            body.style.overflow = '';
          });
        }

        function animateClose(details) {
          const body = details.querySelector(':scope > .details-body');
          if (!body) return;
          const items = pickItems(details);

          body.style.overflow = 'hidden';
          body.style.height = body.scrollHeight + 'px';
          // force reflow
          void body.offsetHeight;
          body.style.transition = `height ${HEIGHT_MS}ms cubic-bezier(0.4, 0, 0.2, 1)`;

          // Re-add 'open' so we can animate before browser collapses; remove after anim
          details.setAttribute('open', '');

          requestAnimationFrame(() => {
            items.forEach((it) => {
              it.style.transition = `opacity 160ms ease, transform 200ms ease`;
              it.style.transitionDelay = '0ms';
              it.style.opacity = '0';
              it.style.transform = 'translateY(8px)';
            });
            body.style.height = '0px';
          });

          body.addEventListener('transitionend', function onEnd(e) {
            if (e.propertyName !== 'height') return;
            body.removeEventListener('transitionend', onEnd);
            details.removeAttribute('open');
            body.style.height = '';
            body.style.overflow = '';
            body.style.transition = '';
          });
        }

        function bind(details) {
          if (details.dataset.animBound) return;
          details.dataset.animBound = '1';
          details.classList.add('js-anim-ready');

          // initial state: closed, items hidden
          const items = pickItems(details);
          items.forEach(resetItem);
          const body = details.querySelector(':scope > .details-body');
          if (body) {
            body.style.height = '0px';
            body.style.overflow = 'hidden';
          }

          // Hijack summary click — prevent default toggle, animate manually
          const summary = details.querySelector(':scope > summary');
          if (!summary) return;
          summary.addEventListener('click', (e) => {
            e.preventDefault();
            if (details.open) {
              animateClose(details);
            } else {
              details.setAttribute('open', '');
              animateOpen(details);
            }
          });
        }

        function init() {
          document.querySelectorAll('details').forEach(bind);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();

      // Reveal-on-scroll — IntersectionObserver навешивает .is-visible на элементы с .reveal
      (() => {
        function init() {
          const items = document.querySelectorAll('.reveal');
          if (!items.length) return;

          if (!('IntersectionObserver' in window)) {
            items.forEach((el) => el.classList.add('is-visible'));
            return;
          }

          const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          }, { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });

          items.forEach((el) => io.observe(el));
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();

    </script>
  </body>
</html>
