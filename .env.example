# URL Google Apps Script webhook'а который принимает заявки с лендинга.
# Получается после Deploy → Web App в _server/gas-webhook.gs (см. _server/README.md).
# Префикс PUBLIC_ обязателен — переменная попадает в клиентский bundle.
# Если оставить пустым — форма падает на mailto fallback.
PUBLIC_FORM_WEBHOOK_URL=
